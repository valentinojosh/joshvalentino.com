---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCopy from '../components/EmailCopy.astro';
---
<BaseLayout title="Contact | Josh Valentino" description="Contact Josh Valentino about software engineering opportunities, technical projects, or collaboration.">
  <section class="contact-container page-fade" aria-label="Contact">
    <div class="contact-content">
      <h1 class="visually-hidden">Contact</h1>
      <p>Have an interesting opportunity, project, or just want to chat?
      <br /><br />Feel free to shoot me an <EmailCopy /></p>
    </div>
  </section>
</BaseLayout>
