---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Josh Valentino" description="The requested page could not be found.">
  <section class="not-found shell">
    <p class="eyebrow">404 / Not found</p>
    <h1>This route ends here.</h1>
    <p>The page may have moved during the Portfolio V2 rebuild.</p>
    <a class="text-link text-link--internal" href="/">Return home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70svh;
    padding-block: clamp(5rem, 14vw, 10rem);
  }

  h1 {
    max-width: 10ch;
    margin: 1.2rem 0;
    font-size: clamp(3.5rem, 9vw, 7rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .not-found > p:not(.eyebrow) {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
  }
</style>
