---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  imagePath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  imagePath = '/social/portfolio-default.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url);
const socialImage = new URL(imagePath, site.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a090d" />
<meta name="color-scheme" content="dark" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{title}</title>

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Josh Valentino — software, systems, and application engineering" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content="Josh Valentino — software, systems, and application engineering" />
