---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCopy from './EmailCopy.astro';
---
<BaseLayout>
  <section class="contact-container page-fade" aria-label="About Josh Valentino">
    <div class="contact-content">
      <h1 class="visually-hidden">Josh Valentino — software engineer</h1>
      <p>Hi <span role="img" aria-label="wave">👋🏼</span> I'm Josh Valentino, a software engineer with experience in C#/.NET, Python, SQL, APIs, and production troubleshooting. I spent several years at RxSense building internal tools, improving data workflows, and working with engineers to resolve application issues.
      <br /><br />I also build independent software and systems projects. Explore my <a href="/projects">projects</a> and <a href="/experience">experience</a>, or send me an <EmailCopy /></p>
    </div>
  </section>
</BaseLayout>
