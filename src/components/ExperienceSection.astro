---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/profile';
---

<section id="experience" class="experience-section shell" aria-labelledby="experience-title">
  <SectionHeading id="experience-title" label="01 / Professional experience" title="Engineering in practice." />
  <div class="experience-overview">
    <div>
      <h3>{experience.employer}</h3>
      <p class="job-title">{experience.title}</p>
      <p class="dates"><time datetime={experience.start.date}>{experience.start.label}</time> — <time datetime={experience.end.date}>{experience.end.label}</time> <span aria-hidden="true">·</span> Remote</p>
    </div>
    <p class="overview-copy">{experience.overview}</p>
  </div>
  <div class="experience-stories">
    {experience.stories.map((story) => (
      <article class="story">
        <span class="story-number" aria-hidden="true">{story.number}</span>
        <div>
          <p class="story-tools">{story.tools}</p>
          <h4>{story.title}</h4>
          <p>{story.summary}</p>
          <ul>{story.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experience-section { padding-block: var(--section-space); border-top: 1px solid var(--color-rule); }
  .experience-overview { display: grid; grid-template-columns: 1fr 1.8fr; gap: 2rem 4rem; padding-bottom: 2.5rem; }
  h3 { margin: 0; font-size: 1.65rem; letter-spacing: -0.035em; }
  .job-title { margin: 0.4rem 0; color: var(--color-text-soft); font-weight: 600; }
  .dates { margin: 0.6rem 0 0; color: var(--color-text-muted); font-size: 0.85rem; }
  .dates span { margin-inline: 0.35rem; }
  .overview-copy { max-width: 43rem; margin: 0; color: var(--color-text-soft); font-size: 1.08rem; }
  .experience-stories { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-rule); }
  .story { min-width: 0; padding: 2rem 1.75rem 0 0; }
  .story + .story { padding-left: 1.75rem; border-left: 1px solid var(--color-rule); }
  .story-number { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.8rem; }
  .story-tools { margin: 1.6rem 0 0.6rem; color: var(--color-accent-soft); font-size: 0.75rem; }
  h4 { margin: 0; font-size: 1.3rem; line-height: 1.3; letter-spacing: -0.025em; }
  .story p:not(.story-tools), li { color: var(--color-text-soft); font-size: 0.95rem; line-height: 1.65; }
  .story p:not(.story-tools) { margin: 1rem 0; }
  ul { margin: 0; padding-left: 1.1rem; }
  li + li { margin-top: 0.8rem; }
  li::marker { color: var(--color-accent); }
  @media (max-width: 58rem) {
    .experience-stories { grid-template-columns: 1fr; }
    .story, .story + .story { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; padding: 1.75rem 0; border-left: 0; }
    .story + .story { border-top: 1px solid var(--color-rule); }
    .story-tools { margin-top: 0; }
  }
  @media (max-width: 42rem) { .experience-overview { grid-template-columns: 1fr; } }
</style>
