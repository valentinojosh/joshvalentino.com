---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<article class:list={['project-card', `project-card--${data.prominence}`]}>
  {data.image && data.imageAlt && (
    <div class="project-image">
      <Image
        src={data.image}
        alt={data.imageAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 736px) calc(100vw - 36px), 576px"
        format="webp"
        quality={84}
        loading="lazy"
      />
    </div>
  )}

  <div class="project-content">
    <div class="project-meta">
      <span>{data.category}</span>
      <span>{data.statusLabel}</span>
    </div>
    <h3>{data.title}</h3>
    <p class="project-role">{data.role}</p>
    <p class="project-description">{data.shortDescription}</p>

    {data.engineeringHighlights.length > 0 && (
      <ul>
        {data.engineeringHighlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
      </ul>
    )}

    <p class="technologies" aria-label={`${data.title} technologies`}>
      {data.technologies.join(' · ')}
    </p>

    {(data.detailPage || data.links.length > 0) && (
      <div class="project-links">
        {data.detailPage && <a href={`/work/${project.id}/`}>Case study <span aria-hidden="true">→</span></a>}
        {data.links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    )}

    {data.provisionalNote && <p class="provisional-note">{data.provisionalNote}</p>}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: 0.55rem;
    background: var(--color-surface);
  }

  .project-card--wide {
    grid-column: 1 / -1;
  }

  .project-image {
    height: clamp(9rem, 20vw, 12rem);
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule);
    background: #eef0f3;
  }

  .project-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .project-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .project-meta span:first-child {
    color: var(--color-accent-soft);
    font-weight: 700;
  }

  h3 {
    margin: 0.85rem 0 0;
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    font-weight: 710;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .project-role {
    margin: 0.55rem 0 0;
    color: var(--color-text-soft);
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .project-description {
    margin: 1rem 0 0;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  ul {
    display: grid;
    margin: 1rem 0 0;
    padding: 0;
    gap: 0.55rem;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 0.3rem;
    height: 1px;
    background: var(--color-accent);
    content: '';
  }

  .technologies {
    margin: auto 0 0;
    padding-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    margin-top: 0.9rem;
    gap: 0.4rem 1.15rem;
  }

  .project-links a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .project-links span {
    color: var(--color-accent);
  }

  .provisional-note {
    margin: 0.7rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  @media (max-width: 46rem) {
    .project-card--wide {
      grid-column: auto;
    }

    .project-image {
      height: clamp(10rem, 48vw, 15rem);
    }
  }
</style>
