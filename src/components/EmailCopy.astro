---
import { site } from '../data/site';
---
<button type="button" class="email-copy" data-copy-email={site.email} aria-label={`Copy email address ${site.email} to clipboard`} title="Copy email to clipboard" hidden>email</button><a class="email-fallback" href={`mailto:${site.email}`}>email</a>!<a class="email-open" href={`mailto:${site.email}`} title="Open your email client">(open)</a>
<span class="copy-toast" role="status" aria-live="polite" aria-atomic="true"></span>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const fallback = document.querySelector<HTMLElement>('.email-fallback');
  const toast = document.querySelector<HTMLElement>('.copy-toast');
  if (button && toast) {
    button.hidden = false;
    if (fallback) fallback.hidden = true;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      clearTimeout(timer);
      const email = button.dataset.copyEmail ?? '';
      let copied = false;
      try { await navigator.clipboard.writeText(email); copied = true; } catch {
        const field = document.createElement('textarea');
        field.value = email;
        field.readOnly = true;
        field.style.cssText = 'position:fixed;left:-9999px;top:0';
        document.body.append(field);
        field.select();
        try { copied = document.execCommand('copy'); } catch { /* Keep mailto available. */ }
        field.remove();
        button.focus({ preventScroll: true });
      }
      toast.textContent = copied ? 'Email copied to clipboard' : 'Copy unavailable. Use (open) to email me.';
      toast.classList.add('visible');
      timer = setTimeout(() => toast.classList.remove('visible'), copied ? 1400 : 4000);
    });
  }
</script>
