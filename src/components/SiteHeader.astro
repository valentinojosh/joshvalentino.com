---
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Josh Valentino, home">Josh Valentino</a>
    <nav aria-label="Primary navigation">
      <a href={`${homePrefix}#projects`}>Projects</a>
      <a href={`${homePrefix}#about`}>About</a>
      <a href={`${homePrefix}#contact`}>Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-rule) 80%, transparent);
    background: color-mix(in srgb, var(--color-canvas) 88%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2rem);
  }

  nav a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 140ms ease;
  }

  nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 34rem) {
    .header-inner {
      min-height: 4.4rem;
      gap: 0.8rem;
    }

    .brand {
      font-size: 0.86rem;
    }

    nav {
      gap: 0.7rem;
    }

    nav a {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 22rem) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0;
      padding-block: 0.6rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
