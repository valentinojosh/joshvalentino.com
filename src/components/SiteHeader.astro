---
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
const navigation = [
  ['projects', 'Projects'],
  ['experience', 'Experience'],
  ['expertise', 'Expertise'],
  ['about', 'About'],
  ['contact', 'Contact'],
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Josh Valentino, home"><span class="brand-mark" aria-hidden="true">JV</span><span>Josh Valentino</span></a>
    <nav aria-label="Primary navigation">
      {navigation.map(([anchor, label]) => <a href={`${homePrefix}#${anchor}`}>{label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-rule); background: color-mix(in srgb, var(--color-canvas) 96%, transparent); backdrop-filter: blur(12px); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; color: var(--color-text); font-size: 0.88rem; font-weight: 650; text-decoration: none; letter-spacing: -0.015em; }
  .brand-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--color-rule-strong); border-radius: 0.4rem; color: var(--color-accent-soft); font-size: 0.7rem; letter-spacing: -0.06em; }
  nav { display: flex; gap: clamp(0.8rem, 2.3vw, 1.8rem); align-items: center; }
  nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; min-width: 1.5rem; color: var(--color-text-muted); text-decoration: none; font-size: 0.84rem; font-weight: 550; border-bottom: 2px solid transparent; transition: color 150ms ease, border-color 150ms ease; }
  nav a:hover, nav a:focus-visible { color: var(--color-text); border-bottom-color: var(--color-accent); }
  @media (max-width: 46rem) {
    .header-inner { align-items: flex-start; flex-direction: column; gap: 0; padding-block: 0.45rem 0.1rem; }
    .brand { font-size: 0.85rem; }
    .brand-mark { width: 1.75rem; height: 1.75rem; }
    nav { width: 100%; justify-content: space-between; gap: 0.3rem; flex-wrap: wrap; }
    nav a { font-size: 0.78rem; }
  }
</style>
