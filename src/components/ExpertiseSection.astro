---
import SectionHeading from './SectionHeading.astro';
import { expertise } from '../data/profile';
---

<section id="expertise" class="expertise-section shell" aria-labelledby="expertise-title">
  <SectionHeading id="expertise-title" label="03 / Technical scope" title="Software, systems & hands-on technology" />
  <div class="expertise-grid">
    {expertise.map((area, index) => (
      <article>
        <div class="area-heading"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{area.title}</h3></div>
        <p class="area-context">{area.context}</p>
        <p class="area-description">{area.description}</p>
        <p class="area-tools" aria-label={`${area.title} tools and practices`}>{area.tools.join(' · ')}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .expertise-section { padding-block: var(--section-space); }
  .expertise-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 2.25rem; }
  article { min-width: 0; padding-top: 1.25rem; border-top: 1px solid var(--color-rule-strong); }
  .area-heading { display: flex; align-items: baseline; gap: 0.65rem; }
  .area-heading span { color: var(--color-accent); font: 0.65rem var(--font-mono); }
  h3 { margin: 0; font-size: 1.1rem; letter-spacing: -0.02em; font-weight: 650; line-height: 1.4; }
  .area-context { margin: 0.5rem 0 0; font-size: 0.72rem; line-height: 1.6; color: var(--color-accent-soft); }
  .area-description { margin: 0.9rem 0 1rem; font-size: 0.93rem; line-height: 1.75; color: var(--color-text-soft); }
  .area-tools { margin: 0; font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.8; }
  @media (max-width: 63rem) { .expertise-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 38rem) { .expertise-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
</style>
