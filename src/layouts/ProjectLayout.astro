---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const pageTitle = `${data.title} | Josh Valentino`;
---

<BaseLayout
  title={pageTitle}
  description={data.shortDescription}
  canonicalPath={`/work/${project.id}/`}
  type="article"
>
  <article class="case-study shell">
    <a class="back-link" href="/#projects">← Back to projects</a>
    <header class="case-header">
      <div>
        <p class="eyebrow">Case study / {data.statusLabel}</p>
        <h1>{data.title}</h1>
        <p class="case-description">{data.shortDescription}</p>
      </div>
      <dl>
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{data.deploymentNote}</dd>
        </div>
        <div>
          <dt>Technology</dt>
          <dd>{data.technologies.join(' / ')}</dd>
        </div>
      </dl>
    </header>

    {data.image && data.imageAlt && (
      <figure class="case-media">
        <Image
          src={data.image}
          alt={data.imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1184px) calc(100vw - 36px), 1184px"
          format="webp"
          quality={88}
        />
      </figure>
    )}

    <div class="case-body">
      {data.links.length > 0 && <aside aria-label="Project links">
        <p class="eyebrow">Evidence</p>
        <ul>
            {data.links.map((link) => (
              <li><a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label}</a></li>
            ))}
        </ul>
      </aside>}
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-block: clamp(3.5rem, 8vw, 7rem) var(--section-space);
  }

  .back-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  .case-header {
    display: grid;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-strong);
    grid-template-columns: minmax(0, 6fr) minmax(18rem, 4fr);
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  h1 {
    margin: 1.2rem 0;
    font-size: clamp(3.25rem, 8vw, 7rem);
    font-weight: 760;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .case-description {
    max-width: 36rem;
    margin: 0;
    color: var(--color-text-soft);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.5;
  }

  dl {
    margin: 0;
  }

  dl div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  dt {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .case-media {
    overflow: hidden;
    margin: clamp(3rem, 8vw, 6rem) 0 0;
    border: 1px solid var(--color-rule);
    border-radius: 0.6rem;
    background: #f4f5f7;
  }

  .case-media :global(img) {
    width: 100%;
    height: auto;
  }

  .case-body {
    display: grid;
    padding-top: clamp(3rem, 7vw, 5rem);
    grid-template-columns: minmax(10rem, 2fr) minmax(0, 7fr) 1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .case-body:not(:has(aside)) { grid-template-columns: minmax(0, 48rem); }

  aside ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  aside li + li {
    margin-top: 0.7rem;
  }

  aside a {
    font-size: 0.78rem;
    line-height: 1.35;
  }

  aside > p:last-child {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 48rem) {
    .case-header,
    .case-body {
      grid-template-columns: 1fr;
    }

    .case-body {
      gap: 1rem;
    }

    aside {
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-rule);
    }
  }
</style>
